{
  "name": "liquidglassjs-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Liquid Glass: the @liquidglassjs packages that power it, plus the showcase.",
  "license": "MIT",
  "author": "Amir Abushanab",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --filter showcase dev",
    "play": "pnpm --filter showcase dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"@liquidglassjs/*\" build",
    "pack:all": "pnpm -r --filter \"@liquidglassjs/*\" exec pnpm pack",
    "release": "pnpm build:packages && changeset publish",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint packages apps",
    "format": "oxfmt packages apps",
    "knip": "knip",
    "depcruise": "depcruise packages apps",
    "check": "oxfmt --check packages apps && oxlint packages apps && pnpm -r typecheck && knip && depcruise packages apps && pnpm skill:validate",
    "check:fix": "oxfmt packages apps && oxlint --fix packages apps",
    "changeset": "changeset",
    "ncu": "pnpm dlx npm-check-updates",
    "prepare": "simple-git-hooks",
    "skill:validate": "pnpm --filter @liquidglassjs/core skill:validate",
    "skill:stale": "pnpm --filter @liquidglassjs/core skill:stale"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.27.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}

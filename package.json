{
  "name": "liquidglassjs-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Liquid Glass: the @liquidglassjs packages that power it, plus the showcase.",
  "license": "MIT",
  "author": "Amir Abushanab",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter showcase dev",
    "play": "pnpm --filter showcase dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"@liquidglassjs/*\" build",
    "pack:all": "pnpm -r --filter \"@liquidglassjs/*\" exec pnpm pack",
    "release": "pnpm build:packages && changeset publish",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint packages apps tests playwright.config.ts",
    "format": "oxfmt packages apps tests playwright.config.ts",
    "knip": "knip",
    "depcruise": "depcruise packages apps",
    "check": "oxfmt --check packages apps tests playwright.config.ts && oxlint packages apps tests playwright.config.ts && pnpm -r typecheck && knip && depcruise packages apps && pnpm skill:validate && pnpm --filter registry check",
    "check:fix": "oxfmt packages apps tests playwright.config.ts && oxlint --fix packages apps tests playwright.config.ts",
    "changeset": "changeset",
    "ncu": "pnpm dlx npm-check-updates",
    "prepare": "simple-git-hooks",
    "skill:validate": "pnpm --filter @liquidglassjs/core skill:validate",
    "skill:stale": "pnpm --filter @liquidglassjs/core skill:stale",
    "test": "playwright test"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
